{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-kubernetes",
  "description": "Kubernetes monitoring & ops for AI agents — safe-by-default access modes and guards.",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-kubernetes",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-kubernetes",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KUBECONFIG_PATH",
          "description": "Path to a kube-config file (empty = default resolution).",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "K8S_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
