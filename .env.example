# --- Connection -------------------------------------------------------------
# Path to a kube-config file. Leave empty to use the default resolution
# (KUBECONFIG env var, then ~/.kube/config).
KUBECONFIG_PATH=
# Load in-cluster credentials (service account) instead of a kube-config file.
K8S_IN_CLUSTER=false
# Default context to use when a tool call omits one. Empty = current-context.
K8S_CONTEXT=

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
K8S_MODE=read-only
# Comma-separated namespace allowlist. Empty = all namespaces.
K8S_NAMESPACE_ALLOWLIST=
# Namespaces that can be read but never mutated. Default: kube-system,kube-public,kube-node-lease.
K8S_PROTECTED_NAMESPACES=kube-system,kube-public,kube-node-lease
# Comma-separated context allowlist. Empty = any context in the kube-config.
K8S_CONTEXT_ALLOWLIST=
# delete_resource requires this in addition to admin mode.
K8S_ALLOW_DELETE=false
# apply_manifest requires this in addition to read-write mode.
K8S_ALLOW_APPLY=false
# exec_in_pod requires this in addition to admin mode.
K8S_ALLOW_EXEC=false
# Validate + log writes without sending them to the cluster.
K8S_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
K8S_AUDIT_LOG=true
